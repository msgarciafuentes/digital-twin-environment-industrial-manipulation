          <!-- Rounded nodes for elastic segmented look -->
          <geom name="demo_wire_bridge_cable_node_01" type="sphere" pos="0.055 0.105 0.013" size="0.008" rgba="0.92 0.86 0.72 1" contype="0" conaffinity="0"/>
          <geom name="demo_wire_bridge_cable_node_02" type="sphere" pos="0.085 0.205 0.010" size="0.008" rgba="0.92 0.86 0.72 1" contype="0" conaffinity="0"/>
          <geom name="demo_wire_bridge_cable_node_03" type="sphere" pos="0.125 0.290 0.006" size="0.008" rgba="0.92 0.86 0.72 1" contype="0" conaffinity="0"/>
