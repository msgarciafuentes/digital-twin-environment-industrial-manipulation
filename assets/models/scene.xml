<mujoco model="fusion_preview_all_parts">

  <!--
    Place this XML in the same folder as:
      switch_tile.stl
      led_tile.stl
      connector_tile.stl
      part_300_mm.stl
      part_450_mm.stl
      part_600_mm.stl

    Notes:
    - scale="0.001 0.001 0.001" assumes Fusion exported in millimeters.
    - If the objects look too small, change scale to 0.01 or 1 depending on your export units.
    - You can comment out any <mesh> in <asset> and/or any <body> in <worldbody>.
  -->

  <compiler angle="degree" coordinate="local" meshdir="."/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.3 0.3 0.3" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <!-- ========================= -->
    <!--           MESHES          -->
    <!-- ========================= -->

    <!-- Comment out any mesh you do not want to load -->

    <mesh name="switch_tile_mesh"     file="../meshes/switch_tile.stl"    scale="0.005 0.005 0.005"/>
    <mesh name="led_tile_mesh"        file="../meshes/led_tile.stl"       scale="0.005 0.005 0.005"/>
    <mesh name="connector_tile_mesh"  file="../meshes/connector_tile.stl" scale="0.005 0.005 0.005"/>
    <mesh name="normal_tile_mesh"  file="../meshes/normal_tile.stl" scale="0.005 0.005 0.005"/>

    <!-- Note: this filename includes a space before .stl -->
    <mesh name="part_300mm_mesh"      file="../meshes/part_300_mm.stl"         scale="0.005 0.005 0.005"/>
    <mesh name="part_450mm_mesh"      file="../meshes/part_450_mm.stl"          scale="0.005 0.005 0.005"/>
    <mesh name="part_600mm_mesh"      file="../meshes/part_600_mm.stl"          scale="0.005 0.005 0.005"/>

    <mesh name="fiber_optic_cord_mesh" file="../meshes/optic_cord.stl" scale="0.005 0.005 0.005"/>
    <mesh name="fiber_optic_adapter_mesh" file="../meshes/fiber_optic_adapter.stl" scale="0.004 0.004 0.004"/>
    <mesh name="bnc_connector1" file="../meshes/bnc_connector_01.stl" scale="0.005 0.005 0.005"/>
    <mesh name="bnc_connector2" file="../meshes/bnc_connector_02.stl" scale="0.004 0.004 0.004"/>
    <mesh name="banana_connector" file="../meshes/banana_connector.stl" scale="0.004 0.004 0.004"/>
    
    <!-- Visual-only STL component cluster. Keep these STL files in the same folder as this XML. -->
    <mesh name="slide_top_mesh"        file="../meshes/slide_neck.stl"       scale="0.005 0.005 0.005"/>
    <mesh name="slide_screw_mesh"      file="../meshes/slide_screw.stl"     scale="0.005 0.005 0.005"/>
    <mesh name="leads1_mesh"           file="../meshes/lead_screw.stl"          scale="0.005 0.005 0.005"/>
    <mesh name="cover_e_mesh"          file="../meshes/slide_head.stl"         scale="0.005 0.005 0.005"/>
    <mesh name="buttom_mesh"           file="../meshes/slide_bottom.stl"          scale="0.005 0.005 0.005"/>
    <mesh name="stepper_v1_mesh"       file="../meshes/stepper.obj"      scale="0.005 0.005 0.005"/>

    <!-- Demo movable wire cluster meshes -->
    <mesh name="demo_wire_optic_cord_mesh" file="../meshes/optic_cord.stl" scale="0.005 0.005 0.005"/>
    <mesh name="demo_wire_bnc_connector1_mesh" file="../meshes/bnc_connector_01.stl" scale="0.005 0.005 0.005"/>

    <mesh name="module_13_base_mesh" file="../meshes/base.stl" scale="0.005 0.005 0.005"/>
    <mesh name="module_13_slide1_mesh" file="../meshes/slide_cover.stl" scale="0.005 0.005 0.005"/>
    
    <!-- ========================= -->
    <!--           TEXTURES        -->
    <!-- ========================= -->

    <texture name="wood_tex" type="2d" file="../textures/wood.png"/>
    <material name="wood_mat" texture="wood_tex" texrepeat="3 3"/>
  </asset>

  <default>
    <geom type="mesh"
          contype="0"
          conaffinity="0"
          rgba="0.72 0.72 0.72 1"/>

    <default class="switch_visual">
      <geom type="box" contype="1" conaffinity="1" friction="1 0.1 0.1"/>
    </default>
  </default>

  <worldbody>
    <!-- ========================= -->
    <!--      LIGHTS / FLOOR       -->
    <!-- ========================= -->

    <light name="top_light_1" pos="0 0 3"/>
    <light name="top_light_2" pos="2 0 3"/>
    <light name="top_light_3" pos="-2 0 3"/>

    <geom name="floor" type="plane" size="5 5 0.1" rgba="0 0 0 1"/>

    <!-- ========================= -->
    <!--         CAMERAS           -->
    <!-- ========================= -->

    <!-- Wide camera for all parts -->
    <camera name="overview" pos="0 2.8 1.6" xyaxes="1 0 0 0 0.5 1"/>

    <!-- Alternative side camera -->
    <camera name="side" pos="3 0 1.2" xyaxes="0 1 0 -0.3 0 1"/>

    <!-- ========================= -->
    <!--        MESH BODIES        -->
    <!-- ========================= -->

    <!-- ========================= -->
    <!--       MODULE 13 CLUSTER   -->
    <!-- ========================= -->
    <!--
      Module 13 structure:
      - A rectangular support block similar in height to stepper
      - base sits on top of the rectangle
      - Two slide_cover sliders sit on top of base
        - one normal
        - one mirrored by 180-degree rotation

      Move the whole module by changing only:
      module_13_cluster_1 pos/euler
    -->
    <body name="module_13_cluster_1" pos="-3.75 -0.07 0.05" euler="0 0 0">

      <!-- Rectangular support block, similar height to stepper -->
      <!-- stepper scaled height is approximately 0.3375 -->
      <body name="module_13_support_body" pos="0 0 0">
        <geom name="module_13_support_geom"
              type="box"
              size="0.13 0.155 0.1"
              pos="0 0 0.11"
              rgba="0.12 0.12 0.13 1"
              contype="0"
              conaffinity="0"/>
      </body>

      <!-- Fixed base sitting on top of the rectangle -->
      <body name="module_13_base_body" pos="0.0015 -0.045 0.2" euler="0 0 180">
        <geom name="module_13_base_geom"
              type="mesh"
              mesh="module_13_base_mesh"
              rgba="0.8 0.1 0.6 1"
              contype="0"
              conaffinity="0"/>
      </body>

      <!-- ========================= -->
      <!--     NORMAL SLIDER         -->
      <!-- ========================= -->
      <body name="module_13_normal_slide_body" pos="0.05 0 0.25">

        <!-- Required because this body has a slide joint -->
        <inertial pos="0 0 0"
                  mass="0.10"
                  diaginertia="0.001 0.001 0.001"/>

        <!-- Forward/back slide movement -->
        <joint name="module_13_normal_slide_joint"
              type="slide"
              axis="1 0 0"
              range="-1 0.04"
              limited="true"
              damping="60"/>

        <!-- Offset centers the STL mesh on the slider body -->
        <body name="module_13_normal_slide_mesh_body"
              pos="-0.246 0.043775 -0.050153"
              euler="0 0 0">

          <geom name="module_13_normal_slide_geom"
                type="mesh"
                mesh="module_13_slide1_mesh"
                rgba="0.8 0.1 0.6 1"
                contype="0"
                conaffinity="0"/>
        </body>
      </body>

      <!-- ========================= -->
      <!--     MIRRORED SLIDER       -->
      <!-- ========================= -->
      <body name="module_13_mirrored_slide_body" pos="-0.05 0 0.25">

        <!-- Required because this body has a slide joint -->
        <inertial pos="0 0 0"
                  mass="0.10"
                  diaginertia="0.001 0.001 0.001"/>

        <!-- Forward/back slide movement -->
        <joint name="module_13_mirrored_slide_joint"
              type="slide"
              axis="-1 0 0"
              range="-1 0.04"
              limited="true"
              damping="60"/>

        <!-- Mirrored visually by rotating the STL 180 degrees around Z -->
        <body name="module_13_mirrored_slide_mesh_body"
              pos="0.246 -0.043775 -0.050153"
              euler="0 0 180">

          <geom name="module_13_mirrored_slide_geom"
                type="mesh"
                mesh="module_13_slide1_mesh"
                rgba="0.8 0.1 0.6 1"
                contype="0"
                conaffinity="0"/>
        </body>
      </body>

    </body> 

    <!-- ========================= -->
    <!--   MOVABLE WIRE CLUSTER    -->
    <!-- ========================= -->
    <!--
      Demonstration wire cluster.

      Controls:
      - demo_wire_left_right_slide moves left/right along local X
      - demo_wire_front_back_slide moves front/back along local Z

      The cable bridge visually connects:
      - demo_optic_cord_body
      - demo_bnc_connector1_body

      Visual-only for now: contype/conaffinity are 0.
    -->
    <body name="demo_wire_cluster_lr_slider" pos="-3.75 -0.75 1.75" euler="270 0 0">

      <!-- Required because this body has a joint -->
      <inertial pos="0 0 0"
                mass="0.10"
                diaginertia="0.001 0.001 0.001"/>

      <!-- Left/right slider -->
      <joint name="demo_wire_left_right_slide"
            type="slide"
            axis="1 0 0"
            range="-0.60 0.60"
            limited="true"
            damping="80"/>

      <body name="demo_wire_cluster_fb_slider" pos="0 0 0">

        <!-- Required because this body has a joint -->
        <inertial pos="0 0 0"
                  mass="0.10"
                  diaginertia="0.001 0.001 0.001"/>

        <!-- Front/back slider -->
        <joint name="demo_wire_front_back_slide"
              type="slide"
              axis="0 0 1"
              range="-1 1"
              limited="true"
              damping="80"/>

        <!-- Wire 1 / first connector head -->
        <body name="demo_optic_cord_body" pos="0.01 0 0" euler="0 0 0">
          <geom name="demo_optic_cord_geom"
                type="mesh"
                mesh="demo_wire_bnc_connector1_mesh"
                rgba="0.42 0.43 0.46 1"
                contype="0"
                conaffinity="0"/>
        </body>

        <!-- Visual cable bridge between the two connector heads -->
