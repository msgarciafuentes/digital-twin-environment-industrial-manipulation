          <geom name="demo_wire_bridge_cable_node_08" type="sphere" pos="0.310 0.155 0.012" size="0.008" rgba="0.92 0.86 0.72 1" contype="0" conaffinity="0"/>
          <geom name="demo_wire_bridge_cable_node_09" type="sphere" pos="0.322 0.055 0.014" size="0.008" rgba="0.92 0.86 0.72 1" contype="0" conaffinity="0"/>

        </body>

        <!-- Wire 2 / second connector head -->
        <body name="demo_bnc_connector1_body" pos="0.3 0 0" euler="0 0 0">

          <!-- Required because this body has a hinge joint -->
          <inertial pos="0 0 0"
                    mass="0.10"
                    diaginertia="0.001 0.001 0.001"/>

          <!-- Rotation joint for the wire head -->
          <joint name="demo_bnc_connector1_rotate_joint"
                type="hinge"
                axis="0 0 1"
                range="-180 180"
                limited="true"
                damping="2.0"/>

          <geom name="demo_bnc_connector1_geom"
                type="mesh"
                mesh="demo_wire_bnc_connector1_mesh"
                rgba="0.62 0.64 0.68 1"
                contype="0"
                conaffinity="0"/>
        </body>

      </body>
    </body>

    <!-- ========================= -->
    <!--          SOCKETS          -->
    <!-- ========================= -->

    <body name="adaptor_cluster_1" pos="-3.125 0.33 2.05" euler="90 0 0">
      <body name="fiber_optic_adapter_body" pos="-0.01 0.05 0" euler="180 0 0">
        <geom name="fiber_optic_adapter_geom"
              type="mesh"
              mesh="fiber_optic_adapter_mesh"
              rgba="0.40 0.90 0.82 1"
              contype="0"
              conaffinity="0"/>
      </body>


      <body name="bnc_connector2_body" pos="0.28 -0.3 0" euler="0 0 0">
        <geom name="bnc_connector2_geom"
              type="mesh"
              mesh="bnc_connector2"
              rgba="0.75 0.10 0.12 1"
              contype="0"
              conaffinity="0"/>
      </body>

      <body name="banana_connector_body" pos="-0.01 -0.3 0" euler="180 0 0">
        <geom name="banana_connector_geom"
              type="mesh"
              mesh="banana_connector"
              rgba="0.62 0.64 0.68 1"
              contype="0"
              conaffinity="0"/>
      </body>
    </body>
  
    <!-- ========================= -->
    <!--        SWITCHES           -->
    <!-- ========================= -->
    <!-- coord for cluster LEFT to RIGHT: -3.85, -3.125, -2.36, -1.625 -->
    <!-- coord for cluster DOWN to UP: 0.56, 1.30, 2.05-->
      <!-- 4-switch cluster.
        Move the whole group by changing only this pos. -->
      <body name="switch_cluster_1" pos="-3.85 0.33 2.05" euler="90 0 0">

          <!-- Top-left switch -->
          <body name="panel_switch_mount_1" pos="-0.075 0.06 0">
              <geom name="panel_switch_base_1" class="switch_visual"
                    size="0.035 0.02 0.008"
                    pos="0 0 0"
                    rgba="0.15 0.15 0.15 1"/>

              <body name="panel_switch_toggle_1" pos="0 0 0.008">
                  <joint name="panel_switch_hinge_1"
                        type="hinge"
                        axis="1 0 0"
                        range="-0.6 0.6"
                        damping="0.4"
                        frictionloss="0.05"/>

                  <geom name="panel_switch_lever_1"
                        class="switch_visual"
                        type="box"
                        size="0.008 0.012 0.03"
                        pos="0 0 0.03"
                        rgba="0.85 0.15 0.15 1"/>
              </body>
          </body>

          <!-- Top-right switch -->
          <body name="panel_switch_mount_2" pos="0.3 0.06 0">
