                  <joint name="panel_switch_hinge_2"
                        type="slide"
                        axis="0 0 -1"
                        range="0 0.05"
                        damping="1.0"
                        stiffness="8.0"
                        frictionloss="0.02"/>

                  <geom name="panel_push_button_red"
                        type="cylinder"
                        size="0.026 0.02"
                        pos="0 0 0"
                        rgba="0.85 0.05 0.05 1"
                        contype="1"
                        conaffinity="1"
                        density="500"/>
              </body>
          </body>

          <!-- Bottom-left switch -->
